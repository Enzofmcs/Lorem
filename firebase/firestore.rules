rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleAccount(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function hp(uid, key) { return /databases/$(database)/documents/users/$(uid)/handles/$(key); }
    function ap(uid, key, id) { return /databases/$(database)/documents/users/$(uid)/handles/$(key)/ipsums/$(id); }
    function lp(uid) { return /databases/$(database)/documents/users/$(uid)/runtime/current; }
    function expiry(d) { return d.startedAt + duration.value(7200000, 'ms'); }
    function boundary(d) { return d.cutoffAt == null ? expiry(d) : d.cutoffAt; }
    function locked(uid, key, id) {
      let l = getAfter(lp(uid)).data;
      return l.handleKey == key && l.ipsumId == id;
    }
    function unlocked(uid) {
      return !existsAfter(lp(uid));
    }
    function selectedHandle(uid, key, binding) {
      let path = /databases/$(database)/documents/users/$(uid)/runtime/selection;
      let selection = get(path).data;
      return selection.handleKey == key && selection.bindingVersion == binding
        && getAfter(path).data == selection;
    }
    function hasDuel(d) { return 'virtualDuel' in d.snapshot; }
    function validDuelStart(s, h) {
      let p = s.virtualDuel;
      let delta = s.rating * 1000000 - p.ratingMicros;
      return p is map && p.keys().hasAll(['policy', 'model', 'sha256', 'ratingMicros', 'difficulty', 'curveMin', 'k', 'horizonMillis', 'assistance'])
        && p.keys().hasOnly(['policy', 'model', 'sha256', 'ratingMicros', 'difficulty', 'curveMin', 'k', 'horizonMillis', 'assistance'])
        && p.policy == 'virtual-duel-v1' && p.model == 'km-delta-isotonic-20261020-v1'
        && p.sha256 == '69954b61bc111b2b2b1c33efef7e66978a74a378244ef0f41f834f9d6a8daea3'
        && p.ratingMicros is int && p.ratingMicros == h.get('duelRatingMicros', 800000000)
        && p.ratingMicros >= 21000000 && p.ratingMicros <= 3857000000
        && p.difficulty == s.rating && p.difficulty >= 800 && p.difficulty <= 3500
        && p.curveMin in [-1200, -800, -400, 0, 400, 800, 1200]
        && delta >= p.curveMin * 1000000 && delta < (p.curveMin + 400) * 1000000
        && p.k in [32, 64] && p.horizonMillis == 7200000 && p.assistance == 'unassisted';
    }
    function validDuelResult(d) {
      let p = d.snapshot.virtualDuel;
      let r = d.result.virtualDuel;
      let horizon = {"-1200": 998444, "-800": 988329, "-400": 911503, "0": 729676, "400": 611844, "800": 566236, "1200": 566236}[string(p.curveMin)];
      let delta = d.result.accepted ? (p.k / 2) * (1000000 - r.cdfLeft - r.cdfAt) : -(p.k / 2) * horizon;
      return d.hintAt == null && r is map
        && r.keys().hasAll(['beforeMicros', 'deltaMicros', 'afterMicros', 'cdfLeft', 'cdfAt', 'cdfHorizon'])
        && r.keys().hasOnly(['beforeMicros', 'deltaMicros', 'afterMicros', 'cdfLeft', 'cdfAt', 'cdfHorizon'])
        && r.beforeMicros == p.ratingMicros && r.beforeMicros is int && r.deltaMicros is int && r.afterMicros is int
        && r.cdfLeft is int && r.cdfAt is int && r.cdfHorizon == horizon
        && r.cdfLeft >= 0 && r.cdfLeft <= r.cdfAt && r.cdfAt <= horizon
        && (d.result.endedAt.toMillis() - d.startedAt.toMillis() < 7200000 || r.cdfAt == horizon)
        && r.deltaMicros == delta && r.afterMicros == r.beforeMicros + r.deltaMicros;
    }
    function duelProgress(n, old, a) {
      return hasDuel(a)
        ? ('duelRatingMicros' in n && n.duelRatingMicros == a.result.virtualDuel.afterMicros
          && a.snapshot.virtualDuel.ratingMicros == old.get('duelRatingMicros', 800000000))
        : n.get('duelRatingMicros', null) == old.get('duelRatingMicros', null);
    }
    function validScoring(s) {
      let p = s.scoring;
      let b = p.limits;
      return p is map && p.keys().hasAll(['policyVersion', 'limits', 'bonusMultiplier', 'reductionMultiplier',
          'modelVersion', 'artifactSha256', 'ratingSource', 'inputRating', 'unavailableReason'])
        && p.keys().hasOnly(['policyVersion', 'limits', 'bonusMultiplier', 'reductionMultiplier',
          'modelVersion', 'artifactSha256', 'ratingSource', 'inputRating', 'unavailableReason'])
        && p.ratingSource == 'codeforces_prior' && p.inputRating == s.cfRating
        && p.bonusMultiplier is number && p.bonusMultiplier >= 1 && p.bonusMultiplier <= 1.25
        && p.reductionMultiplier is number && p.reductionMultiplier >= 0 && p.reductionMultiplier <= 1
        && ((p.policyVersion == 'D-012' && b == null && p.unavailableReason is string && p.unavailableReason.size() > 0)
          || (p.policyVersion == 'time-curve-v1' && p.unavailableReason == null
            && p.inputRating is int && p.inputRating > 0 && s.cfObservedAt is int && s.cfObservedAt <= request.time.toMillis()
            && p.modelVersion is string && p.modelVersion.size() > 0 && p.artifactSha256 is string && p.artifactSha256.size() == 64
            && b is map && b.keys().hasAll(['t1', 't2', 't3']) && b.keys().hasOnly(['t1', 't2', 't3'])
            && b.t1 is int && b.t2 is int && b.t3 is int && b.t1 > 0 && b.t1 < b.t2 && b.t2 < b.t3 && b.t3 <= 7200000));
    }
    function curveAccepted(d) {
      return d.result.accepted && d.snapshot.get('scoring', {}).get('policyVersion', '') == 'time-curve-v1';
    }
    function validTimeGain(d) {
      let p = d.snapshot.scoring;
      let g = d.result.timeGain;
      // Match the domain's epoch-millisecond inputs. Absolute expiry keeps full Timestamp precision.
      let elapsed = d.result.endedAt.toMillis() - d.startedAt.toMillis();
      let bonus = elapsed < p.limits.t1;
      let normal = elapsed < p.limits.t2;
      let reduced = elapsed < p.limits.t3;
      let factor = bonus ? p.bonusMultiplier : (normal ? 1 : (reduced ? p.reductionMultiplier : 0));
      let hint = int(g.timedGain * 0.25 + 0.5);
      let deduction = hint < 2 ? 2 : hint;
      return g is map && g.keys().hasAll(['policyVersion', 'band', 'baseGain', 'multiplier', 'timedGain', 'hintDeduction', 'gain'])
        && g.keys().hasOnly(['policyVersion', 'band', 'baseGain', 'multiplier', 'timedGain', 'hintDeduction', 'gain'])
        && g.policyVersion == p.policyVersion && g.baseGain is int && g.baseGain >= 8 && g.baseGain <= 40
        && g.band == (bonus ? 'BONUS' : (normal ? 'NORMAL' : (reduced ? 'REDUCED' : 'ZERO')))
        && g.multiplier == factor && g.timedGain is int && g.timedGain == int(g.baseGain * factor + 0.5)
        && g.hintDeduction is int && g.hintDeduction == (d.hintAt == null ? 0 : (deduction > g.timedGain ? g.timedGain : deduction))
        && g.gain == g.timedGain - g.hintDeduction && g.gain == d.result.delta;
    }
    function finalResult(d) {
      let r = d.result;
      return r is map && r.keys().hasAll(['endedAt', 'accepted', 'errors', 'failure', 'delta', 'finalRating', 'expectedTime'])
        && r.keys().hasOnly(['endedAt', 'accepted', 'errors', 'failure', 'delta', 'finalRating', 'expectedTime', 'timeGain', 'virtualDuel'])
        && (hasDuel(d) ? validDuelResult(d) : !('virtualDuel' in r))
        && (curveAccepted(d) ? validTimeGain(d) : !('timeGain' in r))
        && r.endedAt is timestamp && r.endedAt >= d.startedAt && r.endedAt <= boundary(d)
        && r.endedAt <= request.time && r.accepted is bool && r.errors is int && r.errors >= 0
        && r.delta is int && r.delta >= -32 && r.delta <= (curveAccepted(d) ? 50 : 40)
        && r.finalRating is int && r.finalRating == (d.snapshot.initialRating + r.delta >= 0 ? d.snapshot.initialRating + r.delta : 0)
        && r.expectedTime is int && r.expectedTime >= 1800000 && r.expectedTime <= 7200000
        && ((r.accepted && (curveAccepted(d) ? r.delta >= 0 : r.delta > 0) && r.failure == null)
          || (!r.accepted && r.delta < 0 && d.cutoffAt != null && r.endedAt == d.cutoffAt && r.failure == d.failure));
    }

    match /users/{uid} {
      allow get: if googleAccount(uid);
      allow create: if googleAccount(uid)
        && request.resource.data.keys().hasAll(['schemaVersion', 'createdAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'createdAt'])
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;

      match /handles/{handleKey} {
        allow read: if googleAccount(uid);
        allow create: if googleAccount(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.keys().hasAll(['schemaVersion', 'handle', 'handleKey', 'bindingVersion', 'loremRating', 'consolidatedRating', 'progressVersion', 'createdAt'])
          && request.resource.data.keys().hasOnly(['schemaVersion', 'handle', 'handleKey', 'bindingVersion', 'loremRating', 'consolidatedRating', 'progressVersion', 'createdAt'])
          && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
          && request.resource.data.handle is string && request.resource.data.handle.matches('[A-Za-z0-9_.-]{1,64}')
          && request.resource.data.handleKey == handleKey
          && handleKey == 'cf_' + request.resource.data.handle.lower()
          && request.resource.data.bindingVersion is int && request.resource.data.bindingVersion == 1
          && request.resource.data.loremRating is int && request.resource.data.loremRating == 800
          && request.resource.data.consolidatedRating == null
          && request.resource.data.progressVersion is int && request.resource.data.progressVersion == 0
          && request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time;
        allow update: if googleAccount(uid) && validHandleResult();
        allow delete: if false;
        function validHandleResult() {
          let n = request.resource.data;
          let old = resource.data;
          let a = getAfter(ap(uid, handleKey, n.lastIpsumId)).data;
          let before = get(ap(uid, handleKey, n.lastIpsumId)).data;
          return n.diff(old).affectedKeys().hasOnly(['loremRating', 'progressVersion', 'consolidatedRating', 'lastIpsumId', 'duelRatingMicros'])
            && duelProgress(n, old, a)
            && n.progressVersion == old.progressVersion + 1 && n.progressVersion is int && n.loremRating is int && n.loremRating >= 0
            && (n.consolidatedRating == null || (n.consolidatedRating is int && n.consolidatedRating >= 800
              && (old.consolidatedRating == null || n.consolidatedRating >= old.consolidatedRating)))
            && (old.consolidatedRating == null || n.consolidatedRating != null)
            && before.state != 'FINAL' && a.state == 'FINAL' && a.version == old.progressVersion && a.bindingVersion == old.bindingVersion
            && a.snapshot.initialRating == old.loremRating && a.result.finalRating == n.loremRating && unlocked(uid);
        }

        // Only public problem IDs are synchronized from the local archive; no legacy ratings or attempts.
        match /exclusions/{problemKey} {
          allow read: if googleAccount(uid);
          allow create: if googleAccount(uid) && exists(hp(uid, handleKey))
            && request.resource.data.keys().hasOnly(['contestId', 'index', 'source'])
            && request.resource.data.contestId is int && request.resource.data.contestId > 0
            && request.resource.data.index is string && request.resource.data.index.matches('[A-Za-z0-9]+')
            && request.resource.data.source == 'legacy-device-v1'
            && problemKey == string(request.resource.data.contestId) + '_' + request.resource.data.index;
          allow update: if googleAccount(uid) && request.resource.data == resource.data;
          allow delete: if false;
        }

        match /usedProblems/{problemKey} {
          allow read: if googleAccount(uid);
          allow create: if googleAccount(uid) && validUsed();
          allow update, delete: if false;
          function validUsed() {
            let n = request.resource.data;
            let a = getAfter(ap(uid, handleKey, n.ipsumId)).data;
            return n.keys().hasOnly(['ipsumId']) && a.state == 'ACTIVE' && a.startedAt == request.time
              && problemKey == string(a.snapshot.contestId) + '_' + a.snapshot.index
              && locked(uid, handleKey, n.ipsumId);
          }
        }

        match /ipsums/{ipsumId} {
          allow read: if googleAccount(uid);
          allow create: if googleAccount(uid) && validStart();
          allow update: if googleAccount(uid) && validTransition();
          allow delete: if false;
          function validStart() {
            let n = request.resource.data;
            let s = n.snapshot;
            let h = get(hp(uid, handleKey)).data;
            let marker = /databases/$(database)/documents/users/$(uid)/handles/$(handleKey)/usedProblems/$(string(s.contestId) + '_' + s.index);
            return n.keys().hasAll(['handleKey', 'bindingVersion', 'version', 'snapshot', 'state', 'startedAt', 'limitMillis', 'ruleVersion',
                'hintAt', 'cutoffAt', 'closeReason', 'failure', 'result', 'processedAt', 'solvedOutsideAt'])
              && n.keys().hasOnly(['handleKey', 'bindingVersion', 'version', 'snapshot', 'state', 'startedAt', 'limitMillis', 'ruleVersion',
                'hintAt', 'cutoffAt', 'closeReason', 'failure', 'result', 'processedAt', 'solvedOutsideAt'])
              && n.handleKey == handleKey && n.version == h.progressVersion && n.bindingVersion == h.bindingVersion && s.initialRating == h.loremRating
              && n.state == 'ACTIVE' && n.startedAt == request.time && n.limitMillis == 7200000
              && n.ruleVersion == 'spark-2h-v1' && n.hintAt == null && n.cutoffAt == null
              && n.closeReason == null && n.failure == null && n.result == null && n.processedAt == null && n.solvedOutsideAt == null
              && s.keys().hasAll(['handle', 'initialRating', 'contestId', 'index', 'name', 'rating', 'tags', 'originAt',
                'originVerifiedAt', 'originSource', 'originVersion', 'category', 'desiredMin', 'desiredMax', 'fallback',
                'cfRating', 'cfObservedAt', 'factors', 'recentOverlap'])
              && s.keys().hasOnly(['handle', 'initialRating', 'contestId', 'index', 'name', 'rating', 'tags', 'originAt',
                'originVerifiedAt', 'originSource', 'originVersion', 'category', 'desiredMin', 'desiredMax', 'fallback',
                'cfRating', 'cfObservedAt', 'factors', 'recentOverlap', 'scoring', 'virtualDuel'])
              && (!hasDuel(n) || validDuelStart(s, h))
              && (!('scoring' in s) || validScoring(s))
              && s.handle == h.handle && s.contestId is int && s.contestId > 0 && s.index is string
              && s.index.matches('[A-Za-z0-9]+') && s.name is string && s.rating is int && s.rating >= 800
              && s.tags is list && s.factors is list && s.originAt is int && s.originAt >= 1593561600000
              && s.originVerifiedAt is int && s.originVerifiedAt > 0 && s.originSource == 'codeforces:contest.list'
              && s.originVersion == 'origin-20200701-v1' && s.category in ['FLUENCY', 'CURRENT_LEVEL', 'CHALLENGE']
              && s.desiredMin is int && s.desiredMax is int && s.fallback is int && s.fallback >= 0 && s.fallback <= 300
              && !exists(/databases/$(database)/documents/users/$(uid)/handles/$(handleKey)/exclusions/$(string(s.contestId) + '_' + s.index))
              && !existsAfter(/databases/$(database)/documents/users/$(uid)/handles/$(handleKey)/exclusions/$(string(s.contestId) + '_' + s.index))
              && !exists(marker) && getAfter(marker).data.ipsumId == ipsumId && locked(uid, handleKey, ipsumId)
              && !exists(lp(uid)) && selectedHandle(uid, handleKey, n.bindingVersion);
          }
          function validTransition() {
            let n = request.resource.data;
            let old = resource.data;
            let changed = n.diff(old).affectedKeys();
            return (old.state == 'ACTIVE' && n.state == 'ACTIVE'
                && !hasDuel(old) && changed.hasOnly(['hintAt']) && old.hintAt == null && n.hintAt == request.time
                && request.time < expiry(old) && locked(uid, handleKey, ipsumId))
              || (old.state == 'ACTIVE' && n.state == 'CLOSED_AWAITING_VERIFICATION'
                && changed.hasOnly(['state', 'cutoffAt', 'closeReason', 'failure']) && locked(uid, handleKey, ipsumId)
                && ((n.closeReason == 'TIME_LIMIT_EXCEEDED' && request.time >= expiry(old)
                    && n.cutoffAt == expiry(old) && n.failure == 'TIME_EXPIRED')
                  || (n.closeReason == 'GIVE_UP' && request.time < expiry(old) && n.cutoffAt == request.time
                    && n.failure in ['STATEMENT_NOT_UNDERSTOOD', 'LOGIC_NOT_FOUND', 'CONTENT_UNKNOWN',
                      'IMPLEMENTATION_NOT_COMPLETED', 'IMPLEMENTATION_ERROR', 'TIME_EXPIRED'])))
              || (old.state in ['ACTIVE', 'CLOSED_AWAITING_VERIFICATION'] && n.state == 'FINAL'
                && changed.hasOnly(['state', 'result', 'processedAt']) && n.processedAt == request.time
                && (old.state != 'ACTIVE' || n.result.accepted == true) && finalResult(n)
                && getAfter(hp(uid, handleKey)).data.progressVersion == old.version + 1
                && getAfter(hp(uid, handleKey)).data.bindingVersion == old.bindingVersion
                && getAfter(hp(uid, handleKey)).data.loremRating == n.result.finalRating
                && getAfter(hp(uid, handleKey)).data.lastIpsumId == ipsumId
                && duelProgress(getAfter(hp(uid, handleKey)).data, get(hp(uid, handleKey)).data, n) && unlocked(uid))
              || (old.state == 'FINAL' && old.result.accepted == false && old.solvedOutsideAt == null
                && changed.hasOnly(['solvedOutsideAt']) && n.solvedOutsideAt is timestamp
                && n.solvedOutsideAt > boundary(old) && n.solvedOutsideAt <= request.time);
          }
        }
      }

      match /runtime/{runtimeId} {
        allow read: if googleAccount(uid);
      }

      // Existence means an active lock, preserving the account handles contract.
      match /runtime/current {
        allow read: if googleAccount(uid);
        allow create: if googleAccount(uid) && validLock();
        allow update: if false;
        allow delete: if googleAccount(uid) && releaseLock();
        function validLock() {
          let n = request.resource.data;
          let a = getAfter(ap(uid, n.handleKey, n.ipsumId)).data;
          return n.keys().hasAll(['handleKey', 'ipsumId', 'checkedAt'])
            && n.keys().hasOnly(['handleKey', 'ipsumId', 'checkedAt']) && n.checkedAt == request.time
            && n.handleKey is string && n.ipsumId is string
            && !exists(ap(uid, n.handleKey, n.ipsumId)) && a.state == 'ACTIVE' && a.startedAt == request.time;
        }
        function releaseLock() {
          let old = resource.data;
          return get(ap(uid, old.handleKey, old.ipsumId)).data.state != 'FINAL'
            && getAfter(ap(uid, old.handleKey, old.ipsumId)).data.state == 'FINAL';
        }
      }
      // A time confirmation must never create a lock or change the selected handle.
      match /runtime/clock {
        allow read: if googleAccount(uid);
        allow create, update: if googleAccount(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.keys().hasOnly(['checkedAt'])
          && request.resource.data.checkedAt == request.time;
        allow delete: if false;
      }
      match /runtime/selection {
        function validSelection() {
          return googleAccount(uid)
            && exists(/databases/$(database)/documents/users/$(uid))
            && request.resource.data.keys().hasAll(['schemaVersion', 'handleKey', 'bindingVersion', 'selectionVersion', 'selectedAt'])
            && request.resource.data.keys().hasOnly(['schemaVersion', 'handleKey', 'bindingVersion', 'selectionVersion', 'selectedAt'])
            && request.resource.data.schemaVersion is int && request.resource.data.schemaVersion == 1
            && request.resource.data.handleKey is string && request.resource.data.handleKey.matches('cf_[a-z0-9_.-]{1,64}')
            && request.resource.data.bindingVersion is int && request.resource.data.bindingVersion >= 1
            && request.resource.data.selectionVersion is int
            && request.resource.data.selectedAt is timestamp && request.resource.data.selectedAt == request.time
            && exists(/databases/$(database)/documents/users/$(uid)/handles/$(request.resource.data.handleKey))
            && get(/databases/$(database)/documents/users/$(uid)/handles/$(request.resource.data.handleKey)).data.bindingVersion == request.resource.data.bindingVersion
            && !exists(lp(uid)) && !existsAfter(lp(uid));
        }
        allow create: if validSelection() && request.resource.data.selectionVersion == 1;
        allow update: if validSelection() && request.resource.data.selectionVersion == resource.data.selectionVersion + 1;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
