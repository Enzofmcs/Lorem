// Local emulator configuration for the standalone Lorem Mock APK.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function mockId(uid) {
      return uid.matches('mock-[0-9a-f]{64}');
    }

    match /users/{uid} {
      allow get: if mockId(uid);
      allow create: if mockId(uid) &&
        request.resource.data.mockDatasetId == uid &&
        request.resource.data.mockIpsumCount == 200;

      match /handles/cf_mock_excel {
        allow get, create: if mockId(uid);

        match /ipsums/{ipsumId} {
          allow get, list: if mockId(uid);
          allow create: if mockId(uid) &&
            ipsumId.matches('[1-9][0-9]{0,2}') &&
            request.resource.data.state == 'FINAL' &&
            request.resource.data.handleKey == 'cf_mock_excel' &&
            request.resource.data.ruleVersion == 'mock-excel-v1';
        }
        match /usedProblems/{problemId} {
          allow get, list, create: if mockId(uid);
        }
      }
    }
  }
}
